@base <http://www.semanticweb.org/adams/ontologies/2026/9/untitled-ontology-4/> .

<https://w3id.org/FAIR-course-UT/2025-2026/group14/ont> rdf:type owl:Ontology ;
                                                         owl:imports <http://www.w3.org/ns/sosa/> .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/FAIR-course-UT/2025-2026/group14/ont#affectsRegion
:affectsRegion rdf:type owl:ObjectProperty ;
               rdfs:domain :Earthquake ;
               rdfs:range :AffectedRegion ;
               rdfs:comment "Links earthquake to an affected region"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/FAIR-course-UT/2025-2026/group14/ont#AffectedRegion
:AffectedRegion rdf:type owl:Class ;
                rdfs:comment "The region most affected by the earthquake"@en .


###  https://w3id.org/FAIR-course-UT/2025-2026/group14/ont#Earthquake
:Earthquake rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
            rdfs:comment "An earthquake event"@en .


