data:Earthquake-0 a ont:Earthquake ;
    ont:affectsRegion [
        a ont:AffectedRegion ;
        rdfs:label "Mindanao, Philippine"
    ] ;
    schema:location [
        a schema:Place ;
        schema:geo [
            a schema:GeoCoordinates ;
            wgs84:lat "8.01"^^xsd:decimal ;
            wgs84:long "125.2"^^xsd:decimal ;
            geo:asWKT "POINT(125.2 8.01)"^^geo:wktLiteral
        ]
    ] .

data:Earthquake-0-magnitude a sosa:Observation ;
    sosa:hasFeatureOfInterest data:Earthquake-0 ;
    sosa:observedProperty wdt:P2528 ;
    sosa:phenomenonTime [
        a time:Instant ;
        time:inXSDDateTimeStamp "2024-06-23T04:51:49Z"^^xsd:dateTimeStamp
    ] ;
    ont:mode data:Mode-A ;
    sosa:hasResult [
        a qudt:QuantityValue ;
        qudt:numericValue "4.8"^^xsd:decimal ;
        qudt:hasUnit unit:UNITLESS
    ] .

